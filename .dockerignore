# Build context for containers/Dockerfile is the repository root; keep it small and free of
# host-only state (the models/ symlinks point at 100+ GB of weights on the host).
.git
models
logs
hf-cache
.compile-cache
.state
**/__pycache__
**/*.pyc
**/*.egg-info
build
dist
.venv
vllm/*.abi3.so
vllm/_version.py
