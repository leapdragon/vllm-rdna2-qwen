# Build context for containers/Dockerfile is the repository root; keep it small and free of
# host-only state: the models/ symlinks point at 100+ GB of weights, and host build residue
# (CMake caches made under another path, compiled .so files) breaks or masks the in-image build.
.git
models
logs
hf-cache
.compile-cache
.state
.venv
.deps
build
dist
cmake-build*
CMakeCache.txt
CMakeFiles
_skbuild
vllm/*.abi3.so
vllm/_version.py
**/*.egg-info
**/__pycache__
**/*.pyc
.pytest_cache
.mypy_cache
.ruff_cache
