# syntax=docker/dockerfile:1
# ---------------------------------------------------------------------------------------------
# vllm-rdna2-qwen — base image: TheRock ROCm 7.14 + PyTorch 2.12 / Triton 3.7 / torchvision built
# from source for gfx1030 (TheRock publishes no torch wheels for the gfx103X family).
#
# TheRock 7.14 has since left AMD's public download channels (they now carry 10.x), so the ROCm
# install is supplied as a BuildKit build context — the /opt/rocm tree of any TheRock 7.14 install:
#
#   docker buildx build -f containers/Dockerfile.base --build-context rocm=/opt/TheRock/rocm/core-7.14 \
#       -t <base-tag> containers/            (driven by containers/build.sh --base; 2–3 h on 32 cores)
#
# The published base image is therefore the durable 7.14 artifact; the runtime image builds FROM it.
# ---------------------------------------------------------------------------------------------
ARG UBUNTU=ubuntu:24.04
ARG MAX_JOBS=24
ARG PYTORCH_REF=6bbd260
ARG TRITON_REF=f0b55c0
ARG VISION_REF=v0.27.1

# ---- stage 1: ROCm + toolchain -----------------------------------------------------------------
FROM ${UBUNTU} AS rocm-base
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3.12 python3.12-dev python3.12-venv python3-pip git ca-certificates curl \
      build-essential cmake ninja-build pkg-config libnuma-dev libopenblas-dev libssl-dev \
      libffi-dev zlib1g-dev libjpeg-dev libpng-dev libelf-dev libdrm-dev \
 && rm -rf /var/lib/apt/lists/*
# The TheRock install, verbatim (bin/ lib/ llvm/ .kpack/ share/ …).
COPY --from=rocm . /opt/rocm
ENV ROCM_PATH=/opt/rocm ROCM_HOME=/opt/rocm HIP_PATH=/opt/rocm \
    PATH=/opt/venv/bin:/opt/rocm/bin:/opt/rocm/llvm/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    LD_LIBRARY_PATH=/opt/rocm/lib
RUN test -x /opt/rocm/bin/hipcc && test -d /opt/rocm/.kpack \
 && python3.12 -m venv /opt/venv && pip install --upgrade pip wheel \
 && grep -H . /opt/rocm/.info/version

# ---- stage 2: build the wheels with the fork's own script -----------------------------------
FROM rocm-base AS build
ARG MAX_JOBS PYTORCH_REF TRITON_REF VISION_REF
COPY build-torch-rocm714.sh /build/build-torch-rocm714.sh
# Torch first (the script builds torch → triton → vision; vision needs torch installed).
RUN SRC=/build/src OUT=/build/wheels MAX_JOBS=${MAX_JOBS} PYTORCH_REF=${PYTORCH_REF} TRITON_REF=${TRITON_REF} \
    VISION_REF=${VISION_REF} SKIP_VISION=1 bash /build/build-torch-rocm714.sh \
 && pip install /build/wheels/torch-*.whl \
 && SRC=/build/src OUT=/build/wheels VISION_REF=${VISION_REF} SKIP_TORCH=1 SKIP_TRITON=1 \
    bash /build/build-torch-rocm714.sh \
 && ls -la /build/wheels/*.whl

# ---- stage 3: the base image -----------------------------------------------------------------
FROM rocm-base AS final
ARG MAX_JOBS PYTORCH_REF TRITON_REF VISION_REF
RUN --mount=type=bind,from=build,source=/build/wheels,target=/wheels \
    pip install /wheels/torch-*.whl /wheels/triton-*.whl /wheels/torchvision-*.whl \
 && cp -r /opt/rocm/share/amd_smi /tmp/amd_smi && pip install /tmp/amd_smi && rm -rf /tmp/amd_smi \
 && python - <<'PY'
import torch, triton, torchvision, amdsmi  # noqa: F401
flags = (torch._C._cuda_getArchFlags() or "").split()
assert "gfx1030" in flags, flags
assert torch.version.hip and torch.version.hip.startswith("7.14"), torch.version.hip
print(f"base ok: torch {torch.__version__} hip {torch.version.hip} arch {flags}; triton {triton.__version__}; torchvision {torchvision.__version__}")
open("/opt/versions.txt", "w").write(
    f"rocm=TheRock {open('/opt/rocm/.info/version').read().strip()}\ntorch={torch.__version__} (ROCm/pytorch {'%s'})\n"
    f"triton={triton.__version__} (ROCm/triton {'%s'})\ntorchvision={torchvision.__version__} ({'%s'})\n" % ("PYTORCH_REF", "TRITON_REF", "VISION_REF"))
PY
RUN sed -i "s/PYTORCH_REF/${PYTORCH_REF}/; s/TRITON_REF/${TRITON_REF}/; s/VISION_REF/${VISION_REF}/" /opt/versions.txt \
 && cat /opt/rocm/share/therock/therock_manifest.json | head -c 400 | grep -oE '"(the_rock_commit|rocm_package_version)" *: *"[^"]+"' >> /opt/versions.txt; cat /opt/versions.txt
LABEL org.opencontainers.image.title="TheRock ROCm 7.14 + PyTorch 2.12 base for vllm-rdna2-qwen (gfx1030)" \
      org.opencontainers.image.source="https://github.com/leapdragon/vllm-rdna2-qwen" \
      org.opencontainers.image.licenses="MIT AND BSD-3-Clause AND Apache-2.0"
CMD ["/bin/bash"]
